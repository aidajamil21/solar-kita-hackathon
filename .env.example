# Backend API base URL (leave empty to use local demo data)
VITE_API_URL=http://localhost:3000

# Supabase auth.users UUID for demo requests to backend (sent as x-user-id)
VITE_DEMO_USER_ID=

# Existing conversation id in public.conversations for assistant page.
# If not set, app uses 00000000-0000-0000-0000-000000000001.
VITE_DEMO_CONVERSATION_ID=
