# Supabase > Project Settings > API
# Project URL (https, not the postgresql:// connection string)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role secret: server only, never put it in the frontend .env
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PORT=2000
# comma-separate several origins if needed
FRONTEND_URL=http://localhost:5173

# Optional: secret used to sign login tokens (defaults to one derived from the service-role key)
SESSION_SECRET=
# Show every account on the login page for prototype testing (set to false to hide)
SHOW_TEST_ACCOUNTS=true
