# Supabase > Project Settings > API
# Project URL (https, not the postgresql:// connection string)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role secret: server only, never put it in the frontend .env
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PORT=2000
# comma-separate several origins if needed
FRONTEND_URL=http://localhost:5173
